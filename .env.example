# All optional. Copy to .env.local for local development.

# Claim checks with a model (falls back to word overlap without a key).
# Gemini is used when its key is set; Claude when only ANTHROPIC_API_KEY is set.
GEMINI_API_KEY=
# ANTHROPIC_API_KEY=
# REVENANT_LLM=auto        # auto | gemini | anthropic | off
# REVENANT_MODEL=          # override the model id (default gemini-3.8-flash / claude-opus-5-5)

# Shared cache for serverless deployments (Upstash or Vercel KV)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Higher GitHub API limit for README lookups (no scopes needed)
GITHUB_TOKEN=

# Public URL of this deployment
APP_URL=http://localhost:3000

# REVENANT_MAX_LINKS=600
# REVENANT_EXAMINE_PER_HOUR=1500
# REVENANT_MCP_PER_HOUR=300
